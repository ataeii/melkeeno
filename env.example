NEXT_PUBLIC_DOMAIN=http://localhost:3000
NEXT_PUBLIC_API_DOMAIN=http://localhost:3000/api
MONGODB_URI=ADD_YOUR_OWN
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_URL_INTERNAL=http://localhost:3000
NEXTAUTH_SECRET=ADD_YOUR_OWN
CLOUDINARY_CLOUD_NAME=ADD_YOUR_OWN
CLOUDINARY_API_KEY=ADD_YOUR_OWN
CLOUDINARY_API_SECRET=ADD_YOUR_OWN
SMSIR_API_KEY=ADD_YOUR_OWN
SMSIR_TEMPLATE_ID=ADD_YOUR_OWN
GEMINI_API_KEY=ADD_YOUR_OWN
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_LIMIT=50
# Shared Cloudflare Worker relay, used for anything unreachable directly from
# an Iranian server: Gemini (Google geo-blocks it) and Telegram (Iran's own
# censorship DNS-poisons api.telegram.org). Leave unset locally to call
# Gemini directly, as local dev does; Telegram always requires the relay.
RELAY_URL=
RELAY_SECRET=
# Telegram bot — inbound webhooks work fine without the relay; only outbound
# sendMessage/etc. calls need it.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=
